            "type": "string",
            "title": "Instructions",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "tool_bindings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Tool Bindings",
            "default": []
          },
          "mode_definitions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Mode Definitions",
            "default": []
          },
          "sub_agent_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sub Agent Ids",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name",
          "model"
        ],
        "title": "AgentCreate"
      },
      "ApiKeyCreate": {
        "properties": {
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes",
            "default": []
          }
        },
        "type": "object",
