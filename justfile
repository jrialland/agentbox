# Agentbox project tasks. Run `just` to list recipes.

[windows]
set shell := ["pwsh.exe", "-NoProfile", "-Command"]

# List available recipes.
default:
    @just --list

# Install Python and frontend dependencies.
setup:
    uv sync
    cd apps/web && bun install
    bun install --cwd scripts/security-report

# Show the installed tool versions.
doctor:
    uv --version
    bun --version
    just --version

# Format Python code with Ruff's safe fixes.
fmt:
    uv run ruff check --fix packages

# Lint, type-check, and check frontend types.
lint:
    uv run ruff check packages
    uv run ty check packages
    cd apps/web && bunx tsc --noEmit

# Run the agentbox-models tests.
test-models:
    uv run pytest packages/agentbox-models -q

# Run the agentbox-harness tests.
test-harness:
    uv run pytest packages/agentbox-harness -q

# Run the agentbox-providers tests.
test-providers:
    uv run pytest packages/agentbox-providers -q

# Run the agentbox-api tests.
test-api:
    uv run pytest packages/agentbox-api -q

# Run every backend test package separately.
test-backend: test-models test-harness test-providers test-api

# Run frontend unit tests.
test-web:
    cd apps/web && bun run test

# Run all backend and frontend tests.
test: test-backend test-web

# Run one focused backend test file or test node.
test-py path:
    uv run pytest {{path}} -q

# Build the frontend (tsc + Vite).
build-web:
    cd apps/web && bun run build

# Serve the built Storybook at http://localhost:6006.
preview-storybook:
    cd apps/web && bun run preview-storybook

# Run browser end-to-end tests (ports 5173, 8000, 9000, 9999 must be free).
e2e:
    cd apps/web && bun run e2e

# Install the security report tool dependencies.
_security-report-deps:
    bun install --cwd scripts/security-report --frozen-lockfile

# Generate the security audit report (HTML + PDF + JSON).
security-report *args: _security-report-deps
    bun run scripts/security-report/src/main.ts {{args}}

# Run security-report unit tests and type-check.
test-security-report: _security-report-deps
    bun run --cwd scripts/security-report test
    bun run --cwd scripts/security-report typecheck

# Prepare `.env` and any missing dependencies.
_dev-prepare:
    @uv run python -m agentbox_api.dev_prepare

# Start the backend dev server on port 8000.
dev-backend:
    uv run python -m agentbox_api.dev_server

# Start the Vite dev server on port 5173.
dev-web:
    cd apps/web && bun run dev

# Start backend and frontend together.
dev: _dev-prepare migrate
    @just _dev-servers

# Run the backend and frontend dev servers in parallel.
[parallel]
_dev-servers: dev-backend dev-web

# Apply Alembic migrations to the configured database.
migrate:
    uv run alembic -c packages/agentbox-models/alembic.ini upgrade head

# Delete local databases/media and rebuild schema v1.
reset-db:
    uv run python -c "from pathlib import Path; import shutil; [p.unlink(missing_ok=True) for p in (Path('agentbox.db'), Path('e2e.db'))]; [shutil.rmtree(p, ignore_errors=True) for p in (Path('media'), Path('e2e-media'))]"
    uv run alembic -c packages/agentbox-models/alembic.ini upgrade head

# Create an autogenerated Alembic migration (usage: just migration "message").
migration message:
    uv run alembic -c packages/agentbox-models/alembic.ini revision --autogenerate -m "{{message}}"

# Regenerate the OpenAPI document and TypeScript schema.
codegen:
    uv run python apps/web/scripts/gen-openapi.py
    cd apps/web && bun run codegen

# Run lint and all tests.
check: lint test test-security-report

# Format, lint, test, and build everything.
verify: fmt lint test build-web
